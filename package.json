{
  "name": "nestjs-prisma-querybuilder",
  "author": "Hariel Thums <hariel@hotmail.com>",
  "version": "1.8.0",
  "license": "MIT",
  "description": "Prisma QueryBuilder with Nestjs, removing the unused data request and allowing the frontend to choose which data to get, without leaving the REST standard.",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/HarielThums/nestjs-prisma-query-builder#readme",
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/HarielThums/nestjs-prisma-query-builder.git"
  },
  "bugs": {
    "url": "https://github.com/HarielThums/nestjs-prisma-query-builder/issues"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "query",
    "querybuilder",
    "where",
    "filter",
    "select",
    "include",
    "orderBy",
    "sort",
    "take",
    "skip",
    "paginate"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --passWithNoTests --forceExit --maxWorkers=10",
    "test:coverage": "jest --passWithNoTests --forceExit --maxWorkers=10 --coverage",
    "format": "prettier --loglevel=error --cache --write \"src/**/*.ts\"",
    "lint": "eslint --cache \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9.0.0",
    "@prisma/client": ">=4.0.0",
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "qs": "^6.15.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.16",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@typescript-eslint/typescript-estree": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
